:true,"properties":[{"name":"radius","type":"string","value":"70"},{"name":"color","type":"string","value":"16747066"},{"name":"intensity","type":"string","value":"0.85"},{"name":"height","type":"string","value":"4"},{"name":"flicker","type":"string","value":"True"}]},{"id":6,"name":"spawn","type":"spawn","x":304,"y":352,"width":16,"height":16,"rotation":0,"visible":true,"properties":[{"name":"facing","type":"string","value":"up"}]},{"id":7,"name":"interact","type":"interact","x":160,"y":112,"width":16,"height":16,"rotation":0,"visible":true,"properties":[{"name":"interact","type":"string","value":"{\"name\": \"Carpenter\\u2019s chest\", \"lines\": [\"Under a mouldy blanket you find a folded letter.\", \"Empty now. Smells of cedar and damp.\"], \"gives\": {\"id\": \"letter\", \"name\": \"Faded letter\", \"description\": \"\\u201c\\u2026if the mirror in the crypt starts to fog again, do not wait for me.\\u201d\"}, \"usedTile\": 666}"}]},{"id":8,"name":"interact","type":"interact","x":480,"y":368,"width":16,"height":16,"rotation":0,"visible":true,"properties":[{"name":"interact","type":"string","value":"{\"name\": \"Tavern strongbox\", \"lines\": [\"The lock has rusted through. Inside, wrapped in a rag: a heavy iron key.\", \"Nothing else but dust.\"], \"gives\": {\"id\": \"key\", \"name\": \"Rusty key\", \"description\": \"Cold, heavier than it looks. The bow is shaped like a candle flame.\"}, \"usedTile\": 666}"}]},{"id":9,"name":"interact","type":"interact","x":416,"y":144,"width":16,"height":16,"rotation":0,"visible":true,"properties":[{"name":"interact","type":"string","value":"{\"name\": \"Tarnished chalice\", \"lines\": [\"A silver chalice lies in the grass by the chapel. You take it.\"], \"pickup\": {\"id\": \"chalice\", \"name\": \"Tarnished chalice\", \"description\": \"Your reflection in it is a heartbeat late.\"}}"}]},{"id":10,"name":"interact","type":"interact","x":80,"y":352,"width":16,"height":16,"rotation":0,"visible":true,"properties":[{"name":"interact","type":"string","value":"{\"name\": \"Sealed crypt\", \"requires\": {\"item\": \"key\", \"missing\": [\"A squat crypt with an iron door. A candle-shaped keyhole is set in the lock.\", \"Still locked. The key must be somewhere in the village.\"]}, \"lines\": [\"The key turns. Cold air breathes out of the dark \\u2014 and a stair goes down, deeper than the hill it sits on.\", \"Something below is waiting for a light. Not yet. (End of the test level.)\"]}"}]},{"id":11,"name":"interact","type":"interact","x":128,"y":304,"width":16,"height":16,"rotation":0,"visible":true,"properties":[{"name":"interact","type":"string","value":"{\"name\": \"Gravestone\", \"lines\": [\"\\u201cHere lies Elske Wick, who kept the lamps.\\u201d The date has been chiselled away.\"]}"}]},{"id":12,"name":"interact","type":"interact","x":368,"y":176,"width":16,"height":16,"rotation":0,"visible":true,"properties":[{"name":"interact","type":"string","value":"{\"name\": \"Statue of the lamp-keeper\", \"lines\": [\"A stone woman holding up a lantern. Her face has been worn smooth \\u2014 except the eyes.\", \"From this side the statue seems to be looking at you. From the other, at someone behind you.\"]}"}]},{"id":13,"name":"interact","type":"interact","x":256,"y":176,"width":16,"height":16,"rotation":0,"visible":true,"properties":[{"name":"interact","type":"string","value":"{\"name\": \"Campfire\", \"lines\": [\"Freshly fed embers. Whoever tends this fire walked away only minutes ago.\"]}"}]},{"id":14,"name":"interact","type":"interact","x":336,"y":400,"width":16,"height":16,"rotation":0,"visible":true,"properties":[{"name":"interact","type":"string","value":"{\"name\": \"Road sign\", \"lines\": [\"\\u201cMIRROWICK\\u201d. Below it, scratched into the wood: \\u201cBOTH OF THEM\\u201d.\"]}"}]}]}],"tilesets":[{"firstgid":1,"name":"roguelike","image":"tiles.png","imagewidth":968,"imageheight":526,"tilewidth":16,"tileheight":16,"spacing":1,"margin":0,"columns":57,"tilecount":1767}]}